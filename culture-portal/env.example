# Supabase project settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server side only. Used by scripts/seed.mjs and never shipped to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Edge function share-story (Supabase -> Edge Functions -> Secrets)
RESEND_API_KEY=re_xxx
STORY_FROM_EMAIL=culture@yourdomain.com
PUBLIC_APP_URL=https://your-portal-url

# Used by scripts/seed.mjs --with-users. Passwords stay in the environment,
# never in the repository.
SUPER_USER_PASSWORD=
DEMO_USER_PASSWORD=

# Stripe (Supabase -> Edge Functions -> Secrets)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
